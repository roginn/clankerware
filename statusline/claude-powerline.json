{
  "theme": "tokyo-night",
  "display": {
    "padding": 1,
    "style": "powerline",
    "charset": "unicode",
    "lines": [
      {
        "segments": {
          "directory": {
            "enabled": true,
            "style": "fish"
          },
          "git": {
            "enabled": true,
            "showSha": false,
            "showWorkingTree": false,
            "showOperation": false,
            "showTag": false,
            "showTimeSinceCommit": false,
            "showStashCount": false,
            "showUpstream": false,
            "showRepoName": false
          },
          "model": {
            "enabled": true
          },
          "context": {
            "enabled": true,
            "showPercentageOnly": false,
            "displayStyle": "blocks"
          }
        }
      }
    ]
  }
}
